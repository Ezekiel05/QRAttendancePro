# Copy to .env.local and fill in (Supabase dashboard -> Project Settings -> API Keys).
# Leave them empty to run in local mode (data stays in this browser).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (sb_publishable_...). The older "anon" key also works in
# VITE_SUPABASE_ANON_KEY. NEVER use the secret key (sb_secret_... / service_role) here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
